{
  "name": "clots",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Clots: Hem Empire — пошаговая стратегия о разумной крови, строящей империю в сосудистой сети.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && vite build",
    "deploy": "npm run build && gh-pages -d dist",
    "balance": "vite-node scripts/balance.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "balance:mutations": "vite-node scripts/mutations.ts",
    "test:balance": "vitest run --config vitest.balance.config.ts"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "@types/node": "^24.10.1",
    "vite-node": "^3.2.4",
    "@playwright/test": "^1.63.0"
  }
}
